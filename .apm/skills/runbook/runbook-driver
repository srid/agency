#!/usr/bin/env bash
# Generic step-results recorder for runbook tenants. Manages a workflow's
# lifecycle state + step-record list in a JSON file, with all mutations done
# in bash+jq so the caller doesn't burn LLM tokens on JSON arithmetic.
#
# The script knows only about workflow lifecycle (active, status), step
# records (name, status, verification, timestamps, optional reason), and
# arbitrary top-level fields the caller wants to remember. It does NOT
# know about any workflow-specific concepts (e.g. forge or noGit are /do's
# business — /do stashes them via `set` after init).
#
# Usage:
#   runbook-driver --workflow=<name> init
#   runbook-driver --workflow=<name> start <name>
#   runbook-driver --workflow=<name> end <status> <verif> [reason]
#   runbook-driver --workflow=<name> step <name> <status> <verif> <startedAt> <completedAt> [reason]
#   runbook-driver --workflow=<name> skip <name> <reason>
#   runbook-driver --workflow=<name> set <field> <value>
#
# --workflow may also come from the RUNBOOK_WORKFLOW environment variable.
# The state file is .${workflow}-results.json in $PWD.
#
# Every mutation echoes a one-line confirmation on stdout so the caller can
# trust the write succeeded without re-reading the JSON.

set -euo pipefail

# Resolve jq, falling back to nix if not on PATH
if command -v jq &>/dev/null; then
  JQ=jq
else
  JQ="nix run nixpkgs#jq --"
fi

# Parse --workflow=<name> from anywhere in argv (allows it to come before
# or after the subcommand). Falls back to $RUNBOOK_WORKFLOW.
workflow="${RUNBOOK_WORKFLOW:-}"
args=()
for arg in "$@"; do
  case "$arg" in
    --workflow=*) workflow="${arg#*=}" ;;
    *) args+=("$arg") ;;
  esac
done
set -- "${args[@]+${args[@]}}"

if [ -z "$workflow" ]; then
  echo "runbook-driver: --workflow=<name> required (or set RUNBOOK_WORKFLOW)" >&2
  exit 2
fi

FILE=".${workflow}-results.json"

cmd="${1:?Usage: runbook-driver --workflow=<name> <init|start|end|step|skip|set> ...}"
shift

case "$cmd" in
  init)
    startedAt="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    cat > "$FILE" <<ENDJSON
{
  "workflow": "$workflow",
  "startedAt": "$startedAt",
  "active": "working",
  "status": "running",
  "steps": []
}
ENDJSON
    echo "init: startedAt=$startedAt"
    ;;

  start)
    name="${1:?name required}"
    startedAt="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    existing="$($JQ -r '.pendingStep.name // empty' "$FILE")"
    if [ -n "$existing" ]; then
      echo "runbook-driver: pendingStep '$existing' already active — call end before starting '$name'" >&2
      exit 1
    fi
    # shellcheck disable=SC2016
    $JQ --arg n "$name" --arg sa "$startedAt" \
       '.pendingStep = {"name":$n,"startedAt":$sa}' \
       "$FILE" > "${FILE}.tmp" && mv "${FILE}.tmp" "$FILE"
    echo "pending: $name"
    ;;

  end)
    status="${1:?status required (passed|failed|skipped)}"
    verif="${2:?verification required}"
    reason="${3:-}"
    completedAt="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    name="$($JQ -r '.pendingStep.name // empty' "$FILE")"
    startedAt="$($JQ -r '.pendingStep.startedAt // empty' "$FILE")"
    if [ -z "$name" ] || [ -z "$startedAt" ]; then
      echo "runbook-driver: no pendingStep — call start first" >&2
      exit 1
    fi

    if [ -n "$reason" ]; then
      # shellcheck disable=SC2016
      $JQ --arg n "$name" --arg s "$status" --arg v "$verif" \
         --arg sa "$startedAt" --arg ca "$completedAt" --arg r "$reason" \
         '.steps += [{"name":$n,"status":$s,"verification":$v,"startedAt":$sa,"completedAt":$ca,"reason":$r}] | del(.pendingStep)' \
         "$FILE" > "${FILE}.tmp" && mv "${FILE}.tmp" "$FILE"
    else
      # shellcheck disable=SC2016
      $JQ --arg n "$name" --arg s "$status" --arg v "$verif" \
         --arg sa "$startedAt" --arg ca "$completedAt" \
         '.steps += [{"name":$n,"status":$s,"verification":$v,"startedAt":$sa,"completedAt":$ca}] | del(.pendingStep)' \
         "$FILE" > "${FILE}.tmp" && mv "${FILE}.tmp" "$FILE"
    fi
    count="$($JQ -r '.steps | length' "$FILE")"
    pending="$($JQ -r '.pendingStep.name // "none"' "$FILE")"
    echo "recorded: $name $status (steps=$count, pending=$pending)"
    ;;

  step)
    name="${1:?name required}"
    status="${2:?status required (passed|failed|skipped)}"
    verif="${3:?verification required}"
    startedAt="${4:?startedAt required}"
    completedAt="${5:?completedAt required}"
    reason="${6:-}"

    [[ "$startedAt" == "now" ]] && startedAt="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    [[ "$completedAt" == "now" ]] && completedAt="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    if [ -n "$reason" ]; then
      # shellcheck disable=SC2016
      $JQ --arg n "$name" --arg s "$status" --arg v "$verif" \
         --arg sa "$startedAt" --arg ca "$completedAt" --arg r "$reason" \
         '.steps += [{"name":$n,"status":$s,"verification":$v,"startedAt":$sa,"completedAt":$ca,"reason":$r}]' \
         "$FILE" > "${FILE}.tmp" && mv "${FILE}.tmp" "$FILE"
    else
      # shellcheck disable=SC2016
      $JQ --arg n "$name" --arg s "$status" --arg v "$verif" \
         --arg sa "$startedAt" --arg ca "$completedAt" \
         '.steps += [{"name":$n,"status":$s,"verification":$v,"startedAt":$sa,"completedAt":$ca}]' \
         "$FILE" > "${FILE}.tmp" && mv "${FILE}.tmp" "$FILE"
    fi
    count="$($JQ -r '.steps | length' "$FILE")"
    echo "recorded: $name $status (steps=$count)"
    ;;

  skip)
    name="${1:?name required}"
    reason="${2:?reason required}"
    # Back-to-back start+end with status=skipped. Duration is 0.
    startedAt="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # shellcheck disable=SC2016
    $JQ --arg n "$name" --arg s "skipped" --arg v "" \
       --arg sa "$startedAt" --arg ca "$startedAt" --arg r "$reason" \
       '.steps += [{"name":$n,"status":$s,"verification":$v,"startedAt":$sa,"completedAt":$ca,"reason":$r}]' \
       "$FILE" > "${FILE}.tmp" && mv "${FILE}.tmp" "$FILE"
    echo "skipped: $name ($reason)"
    ;;

  set)
    field="${1:?field required}"
    value="${2:?value required}"
    if [ "$value" = "true" ] || [ "$value" = "false" ]; then
      # shellcheck disable=SC2016
      $JQ --arg f "$field" --argjson v "$value" '.[$f] = $v' "$FILE" > "${FILE}.tmp" && mv "${FILE}.tmp" "$FILE"
    else
      # shellcheck disable=SC2016
      $JQ --arg f "$field" --arg v "$value" '.[$f] = $v' "$FILE" > "${FILE}.tmp" && mv "${FILE}.tmp" "$FILE"
    fi
    echo "set: $field=$value"
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    echo "Usage: runbook-driver --workflow=<name> <init|start|end|step|skip|set> ..." >&2
    exit 1
    ;;
esac
